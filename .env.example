# From the repository root:
#   cp .env.example .env
#   export CAREPATH_ENV_FILE="$PWD/.env"
# The copied .env file is ignored by Git.
# Never add real credentials to this example.
CAREPATH_APP_NAME=CarePath API
CAREPATH_ENVIRONMENT=development
CAREPATH_PRIVACY_MODE=standard_demo
CAREPATH_LOG_LEVEL=INFO
CAREPATH_REQUEST_ID_HEADER=X-Request-ID
CAREPATH_REQUEST_ID_MAX_LENGTH=128
CAREPATH_LLM_PROVIDER=mock

# Storage. SQLite is the local single-process default; deployed containers should use PostgreSQL.
CAREPATH_DATABASE_URL=sqlite:///./carepath.db

# Optional account authentication. Leave both empty to keep the app anonymous-only.
# These are Supabase project values. The publishable key is intentionally safe for client use;
# never put a service_role or secret key here.
CAREPATH_SUPABASE_URL=
CAREPATH_SUPABASE_PUBLISHABLE_KEY=
CAREPATH_AUTH_REQUEST_TIMEOUT_SECONDS=5

# User-facing Private mode. Private sessions use isolated in-memory SQLite and never write health
# records, plans, feedback or coaching interactions to CAREPATH_DATABASE_URL. They are destroyed
# explicitly when the client exits Private mode and are also evicted after the idle TTL.
CAREPATH_PRIVATE_SESSION_TTL_MINUTES=60
CAREPATH_PRIVATE_SESSION_MAX_SESSIONS=128

# External evidence remains Qdrant Local in the core architecture. Point this at a persistent
# directory when the index is built for a deployment.
CAREPATH_EVIDENCE_INDEX_PATH=data/guidelines/qdrant
CAREPATH_EVIDENCE_COLLECTION_NAME=carepath_guidelines_cp007_v1
CAREPATH_EVIDENCE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional exported Expo Web directory. Leave empty for API-only local development.
# The production Docker image sets this to /app/reviewer_web.
CAREPATH_REVIEWER_WEB_DIR=

# Optional secret. Leave empty when using the development mock provider.
CAREPATH_LLM_API_KEY=

# Generic loopback-only OpenAI-compatible local provider.
# To enable it, set CAREPATH_LLM_PROVIDER=local_openai.
# CAREPATH_PRIVACY_MODE=local_strict is an operator-side LLM boundary and is separate from the
# user-facing in-memory Private mode above.
CAREPATH_LOCAL_LLM_BASE_URL=http://127.0.0.1:8000
CAREPATH_LOCAL_LLM_MODEL_ID=carepath-local
CAREPATH_LOCAL_LLM_STRUCTURED_OUTPUT_MODE=openai_json_schema
CAREPATH_LOCAL_LLM_REQUEST_TIMEOUT_SECONDS=120
CAREPATH_LOCAL_LLM_MAX_NEW_TOKENS=512
CAREPATH_LOCAL_LLM_TEMPERATURE=0
