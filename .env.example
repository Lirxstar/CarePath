# From the repository root:
#   cp .env.example .env
#   export CAREPATH_ENV_FILE="$PWD/.env"
# The copied .env file is ignored by Git.
# Never add real credentials to this example.
CAREPATH_APP_NAME=CarePath API
CAREPATH_ENVIRONMENT=development
CAREPATH_PRIVACY_MODE=standard_demo
CAREPATH_LOG_LEVEL=INFO
CAREPATH_REQUEST_ID_HEADER=X-Request-ID
CAREPATH_REQUEST_ID_MAX_LENGTH=128
CAREPATH_LLM_PROVIDER=mock

# AMD Radeon local inference through a loopback vLLM or llama.cpp server.
# CAREPATH_LLM_PROVIDER=radeon_local
# CAREPATH_PRIVACY_MODE=local_strict
# CAREPATH_RADEON_BASE_URL=http://127.0.0.1:8000
# CAREPATH_RADEON_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# CAREPATH_RADEON_RUNTIME=vllm_rocm
# CAREPATH_RADEON_DEVICE=0
# CAREPATH_RADEON_INFERENCE_DTYPE=fp16
# CAREPATH_RADEON_REQUEST_TIMEOUT_SECONDS=120
# CAREPATH_RADEON_MAX_NEW_TOKENS=512
# CAREPATH_RADEON_TEMPERATURE=0

# Optional secret. Leave empty when using local or development providers.
CAREPATH_LLM_API_KEY=
