# From the repository root:
#   cp .env.example .env
#   export CAREPATH_ENV_FILE="$PWD/.env"
# The copied .env file is ignored by Git.
# Never add real credentials to this example.
CAREPATH_APP_NAME=CarePath API
CAREPATH_ENVIRONMENT=development
CAREPATH_PRIVACY_MODE=standard_demo
CAREPATH_LOG_LEVEL=INFO
CAREPATH_REQUEST_ID_HEADER=X-Request-ID
CAREPATH_REQUEST_ID_MAX_LENGTH=128
CAREPATH_LLM_PROVIDER=mock

# Optional secret. Leave empty when using the development mock provider.
CAREPATH_LLM_API_KEY=

# Generic loopback-only OpenAI-compatible local provider.
# To enable it, set CAREPATH_LLM_PROVIDER=local_openai.
# For the strongest local-only boundary also set CAREPATH_PRIVACY_MODE=local_strict.
CAREPATH_LOCAL_LLM_BASE_URL=http://127.0.0.1:8000
CAREPATH_LOCAL_LLM_MODEL_ID=carepath-local
CAREPATH_LOCAL_LLM_STRUCTURED_OUTPUT_MODE=openai_json_schema
CAREPATH_LOCAL_LLM_REQUEST_TIMEOUT_SECONDS=120
CAREPATH_LOCAL_LLM_MAX_NEW_TOKENS=512
CAREPATH_LOCAL_LLM_TEMPERATURE=0
