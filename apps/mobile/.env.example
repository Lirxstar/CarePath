# Local web/iOS simulator backend. For Expo Go on a physical phone, use the computer's LAN address.
EXPO_PUBLIC_CAREPATH_API_URL=http://127.0.0.1:8000

# Set true for a completely local synthetic UI demo with no backend dependency.
EXPO_PUBLIC_CAREPATH_MOCK_MODE=false

# Set true only for the anonymously accessible public reviewer deployment.
# This enables the persistent public-demo disclosure about data retention and non-diagnostic use.
EXPO_PUBLIC_CAREPATH_PUBLIC_DEMO=false
