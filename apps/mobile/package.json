{
  "name": "@carepath/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "CarePath Expo React Native application shell",
  "main": "index.ts",
  "engines": {
    "node": ">=22.13",
    "npm": ">=10"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "expo:check": "expo config --type public",
    "bundle:check": "expo export --platform ios --output-dir dist/smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:ci": "jest --ci --runInBand --coverage",
    "web": "expo start --web",
    "bundle:web": "expo export --platform web --output-dir dist/web-smoke"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.18",
    "@react-navigation/bottom-tabs": "7.18.14",
    "@react-navigation/native": "^7.3.14",
    "expo": "~56.0.18",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/js": "9.39.5",
    "@jest/globals": "30.4.1",
    "@types/react": "~19.2.2",
    "babel-jest": "30.4.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.4.2",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
