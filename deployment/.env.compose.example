# Local Docker Compose only. Copy to deployment/.env.compose and keep that file untracked.
# This placeholder password is not a production credential; replace it for your local stack.
CAREPATH_POSTGRES_DB=carepath
CAREPATH_POSTGRES_USER=carepath
CAREPATH_POSTGRES_PASSWORD=replace_with_local_only_password
CAREPATH_API_PORT=8000
CAREPATH_APP_NAME=CarePath API
CAREPATH_ENVIRONMENT=development
CAREPATH_PRIVACY_MODE=standard_demo
CAREPATH_LOG_LEVEL=INFO
CAREPATH_LLM_PROVIDER=mock
