flowchart LR
  REVIEWER["Reviewer browser / Expo client"]

  subgraph Local["Local Docker Compose"]
    LWEB["Single application image\nExpo Web + FastAPI + bounded workflow"]
    LDB[("PostgreSQL\npersistent local volume")]
    LMODEL["ModelProvider\nmock or approved local endpoint"]
    LLOG[("Metadata-only logs / audit")]
  end

  subgraph Cloud["Reviewer cloud deployment"]
    CWEB["Single web service\nExpo Web + FastAPI + bounded workflow"]
    CDB[("Managed PostgreSQL")]
    CCONFIG["Runtime environment / secret injection"]
    CLOG[("Metadata-only logs / audit")]
  end

  subgraph Endpoint["Optional model processing boundary"]
    MODEL["Approved local or remote endpoint\nminimized ModelRequest only"]
  end

  REVIEWER -->|"HTTPS · same-origin UI and API"| CWEB
  REVIEWER -. "local review" .-> LWEB

  LWEB <-->|"validated application state"| LDB
  LWEB -->|"IDs/status/latency only"| LLOG
  LWEB --> LMODEL
  LMODEL -. "optional minimized request" .-> MODEL
  MODEL -. "untrusted completion" .-> LMODEL

  CWEB <-->|"validated application state"| CDB
  CCONFIG -->|"runtime configuration\nnever sent to client/model"| CWEB
  CWEB -->|"IDs/status/latency only"| CLOG
  CWEB -->|"sanitized request via ModelProvider"| MODEL
  MODEL -->|"untrusted completion"| CWEB

  LIVE["/health/live\nprocess liveness"]
  READY["/health/ready\ndatabase + provider readiness"]
  CWEB --> LIVE
  CWEB --> READY

  SAMEORIGIN["Production invariant\nreviewer HTML and API share one origin\nno second frontend service or CORS dependency"]
  SAMEORIGIN -. "constrains" .-> CWEB
