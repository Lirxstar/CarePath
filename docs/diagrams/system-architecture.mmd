flowchart LR
  subgraph Client["TB-1 · User device / public client boundary"]
    UI["React Native / Expo\nToday · Coach · Health Data · Plan & History"]
  end

  subgraph Application["Trusted application and policy boundary"]
    API["FastAPI\nschema validation · request IDs · API contracts"]
    SAFE["Safety Triage\ndeterministic rules"]
    CTX["Context Builder\nminimal task context"]
    ROUTER["Tool Router\ntyped allow-listed calls"]
    TOOLS["Deterministic time-series tools\ntrend · windows · change · missingness · adherence"]
    PERSONAL["Personal Context Retriever\nuser-scoped namespace"]
    EXTERNAL["External Evidence Retriever\ncurated namespace"]
    PLAN["Planner\nsmall seven-day actions"]
    VERIFY["Grounding & Safety Verifier\none bounded rewrite"]
    COMPOSE["Response Composer\nstructured answer + uncertainty"]
    PROVIDER["ModelProvider\nreplaceable approved endpoint"]
  end

  subgraph UserData["TB-2 · User data / persistence boundary"]
    DB[("User-scoped records\nPostgreSQL · SQLite for development")]
    PERSONAL_NS[("Personal retrieval namespace\nisolated by user/persona")]
  end

  subgraph Evidence["TB-3 · External evidence lifecycle boundary"]
    SOURCE["Public health / behavioural guidance\nuntrusted before ingestion"]
    INGEST["Evidence ingestion gate\nsource · licence · hash · sanitization"]
    CORPUS[("Curated evidence namespace\nchunks + provenance")]
  end

  subgraph Model["TB-4 · Model endpoint boundary"]
    ENDPOINT["Approved local or remote model endpoint\nminimized payload · no database access"]
  end

  subgraph Audit["TB-5 · Feedback, audit and operations"]
    AUDIT[("Audit events\nrefs + bounded summaries")]
    LOGS[("Operational logs\nIDs · route · status · latency · error class")]
  end

  UI -->|"authenticated + consented"| API
  API --> SAFE --> CTX --> ROUTER
  ROUTER --> TOOLS
  ROUTER --> PERSONAL
  ROUTER --> EXTERNAL
  TOOLS --> PLAN
  PERSONAL --> PLAN
  EXTERNAL --> PLAN
  PLAN --> VERIFY --> COMPOSE --> API
  API -->|"structured response"| UI

  CTX <-->|"user-scoped"| DB
  TOOLS <-->|"selected observations only"| DB
  PERSONAL <-->|"minimal personal context"| PERSONAL_NS
  API -->|"validated plan / feedback writes"| DB

  SOURCE -->|"document + metadata"| INGEST
  INGEST -->|"validated/sanitized chunks"| CORPUS
  EXTERNAL <-->|"eligible chunks + provenance"| CORPUS

  PLAN <-->|"sanitized ModelRequest / normalized draft"| PROVIDER
  PROVIDER -->|"no DB credentials/access"| ENDPOINT
  ENDPOINT -->|"untrusted completion"| PROVIDER

  API -->|"schema-controlled audit event"| AUDIT
  COMPOSE -->|"decision refs + disposition"| AUDIT
  API -->|"status · latency · error class only"| LOGS
